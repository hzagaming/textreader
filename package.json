{
  "name": "textreader",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "extension",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @textreader/extension",
    "build": "npm run build --workspace @textreader/extension",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @textreader/extension",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.3.0",
    "prettier": "^3.8.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.56.1"
  }
}
